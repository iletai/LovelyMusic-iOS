# ────────────────────────────────────────────────────────────
# Cloudflare Worker Environment (REQUIRED before deploy)
# ────────────────────────────────────────────────────────────
# Run: npx wrangler secret put APNS_PRIVATE_KEY
# Run: npx wrangler secret put ADMIN_API_KEY

# NOTE: APNS_PRIVATE_KEY and ADMIN_API_KEY are NOT stored here.
# They are provisioned as Cloudflare Worker Secrets and synced from
# GitHub Actions via .github/workflows/deploy-backend.yml.

# Public / Non-secret configuration (safe to commit):
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.lovelymusic.app
APNS_IS_PRODUCTION=false

# Used by scripts/send_push.py — REQUIRED for CLI broadcast.
# Reference value is NOT committed here; set it in local .env:
#   echo "LOVELYMUSIC_ADMIN_API_KEY=your-secret-key" >> backend/.env
LOVELYMUSIC_ADMIN_API_KEY=

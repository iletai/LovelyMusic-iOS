# ────────────────────────────────────────────────────────────
# LovelyMusic Push Notification — Local Developer Reference
# COPY TO backend/.env AND FILL IN YOUR CREDENTIALS
# ────────────────────────────────────────────────────────────
#
# These values are derived from environment variables.
# Actual secrets live in:
#   - Cloudflare Worker:  secret list  → APNS_PRIVATE_KEY, ADMIN_API_KEY
#   - GitHub Secrets:     gh secret list → same keys + CLOUDFLARE_API_TOKEN
#   - iOS:                 Secrets.plist (gitignored) + Secrets.plist.example

# --- Cloudflare Worker (non-secret) ---
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.lovelymusic.app
APNS_IS_PRODUCTION=false

# --- Cloudflare Auth (REQUIRED for wrangler CLI) ---
# export CLOUDFLARE_API_TOKEN=your-token

# --- Admin / Dev CLI Reference ---
# LOVELYMUSIC_ADMIN_API_KEY=your-admin-api-key
# LOVELYMUSIC_WORKER_URL=https://your-worker-subdomain.workers.dev

# --- APNs Private Key (/*.p8) ---
# Get from https://developer.apple.com/account/resources/authkeys
# APNS_PRIVATE_KEY_P8_FILE_PATH=~/Downloads/AuthKey_YOUR_KEY_ID.p8

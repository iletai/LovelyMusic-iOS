# LovelyMusic - Environment Variables Example
# Copy this file to .env and fill in your secrets

# Backend Cloudflare Worker Configuration
LOVELYMUSIC_WORKER_URL=https://your-worker-subdomain.workers.dev
LOVELYMUSIC_ADMIN_API_KEY=your-admin-api-key

# Apple APNs Configuration
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.lovelymusic.app
APNS_IS_PRODUCTION=false

# App Store Connect & Code Signing
APP_STORE_CONNECT_API_KEY_ID=YOUR_ASC_KEY_ID
APP_STORE_CONNECT_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
MATCH_GIT_URL=git@github.com:your-org/your-certificates-repo.git
